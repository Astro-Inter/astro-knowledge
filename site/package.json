{
  "name": "astro-knowledge-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
